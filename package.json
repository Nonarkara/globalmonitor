{
  "name": "globalmonitor",
  "private": true,
  "version": "8.0.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "design:check": "node .non-slop/bin/non-slop.mjs scan src --fail-on=P1",
    "design:render": "node .non-slop/bin/non-slop.mjs render",
    "verify:live": "node scripts/operational-check.mjs",
    "verify:fit": "node scripts/chrome-fit.mjs",
    "prebuild": "npm run design:check && npm run guard",
    "prebuild:pages": "npm run design:check && npm run guard",
    "api": "node server/index.mjs",
    "dev": "vite",
    "dev:stack": "node scripts/dev-stack.mjs",
    "build": "vite build",
    "build:pages": "vite build",
    "test": "node --test tests/*.test.mjs",
    "test:traffic": "node scripts/traffic-layers-check.mjs",
    "refresh:airports": "node scripts/refresh-airports.mjs",
    "refresh:flights": "node scripts/refresh-flight-snapshot.mjs",
    "refresh:ais": "node scripts/refresh-ais-snapshot.mjs",
    "deploy:pages": "npm run refresh:flights && npm run build:pages && npx wrangler pages deploy dist --project-name asiawatch --branch=main --commit-dirty=true",
    "deploy:pages:ais": "npm run refresh:ais && npm run deploy:pages",
    "lint": "eslint .",
    "preview": "vite preview",
    "start": "node server/index.mjs",
    "guard": "node --test tests/truthfulness.test.mjs tests/live-suite-regressions.test.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "axios": "^1.20.0",
    "d3": "^7.9.0",
    "google-auth-library": "^11.3.1",
    "lucide-react": "^1.61.0",
    "maplibre-gl": "^6.15.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-map-gl": "^8.1.3",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "playwright": "^1.64.1",
    "vite": "^8.3.5"
  },
  "overrides": {
    "esbuild": "0.27.2",
    "js-yaml": "4.3.2"
  }
}
