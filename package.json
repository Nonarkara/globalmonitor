{
  "name": "globalmonitor",
  "private": true,
  "version": "8.0.0",
  "type": "module",
  "scripts": {
    "api": "node server/index.mjs",
    "dev": "vite",
    "dev:stack": "node scripts/dev-stack.mjs",
    "build": "vite build",
    "build:pages": "vite build",
    "test": "node --test tests/*.test.mjs",
    "test:traffic": "node scripts/traffic-layers-check.mjs",
    "refresh:airports": "node scripts/refresh-airports.mjs",
    "refresh:flights": "node scripts/refresh-flight-snapshot.mjs",
    "refresh:ais": "node scripts/refresh-ais-snapshot.mjs",
    "deploy:pages": "npm run refresh:flights && npm run build:pages && npx wrangler pages deploy dist --project-name asiawatch --branch=main --commit-dirty=true",
    "deploy:pages:ais": "npm run refresh:ais && npm run deploy:pages",
    "lint": "eslint .",
    "preview": "vite preview",
    "start": "node server/index.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.105.0",
    "axios": "^1.13.5",
    "d3": "^7.9.0",
    "google-auth-library": "^10.6.2",
    "lucide-react": "^0.575.0",
    "maplibre-gl": "^3.6.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-map-gl": "^7.1.7",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "playwright": "^1.62.1",
    "vite": "^7.3.1"
  },
  "overrides": {
    "esbuild": "0.27.2"
  }
}
